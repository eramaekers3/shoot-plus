# The same two values lifestyle+ uses: Supabase → Project Settings → API.
# shoot+ keeps its data in its own tables in that project (see supabase/shoot-plus.sql).
# Leave them blank and the app still works, saving only on this device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (read-only). Only needed to run the Stripe import locally; on Vercel set these in the project's
# Environment Variables instead. Never put them in a VITE_ variable: those are sent to the browser.
STRIPE_SECRET_KEY=
STRIPE_OWNER_EMAIL=
